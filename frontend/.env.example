# --- Sanity ---------------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" # Optional, defaults to http://localhost:3333
SANITY_API_READ_TOKEN="<paste your token here>" # Required - Viewer token, used for drafts & Visual Editing
SANITY_API_WRITE_TOKEN="" # Required for orders, newsletter & contact form - an Editor token (server-only)

# --- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000" # Absolute URL used for Stripe redirects, sitemap & OG tags

# --- Stripe (use test keys while developing) -------------------------------
STRIPE_SECRET_KEY="" # sk_test_... from https://dashboard.stripe.com/test/apikeys
STRIPE_WEBHOOK_SECRET="" # whsec_... printed by `stripe listen`, or from the dashboard webhook endpoint
